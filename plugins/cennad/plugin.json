{
  "name": "cennad",
  "version": "0.10.10",
  "description": "Cennad — delegate to Codex, Antigravity, or Claude Code CLIs from Claude Code and Codex hosts",
  "author": {
    "name": "Vincent K. Kelvin"
  },
  "repository": "https://github.com/vincent-kk/ogham",
  "homepage": "https://github.com/vincent-kk/ogham/tree/main/plugins/cennad",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "plugin",
    "codex",
    "antigravity",
    "claude",
    "multi-agent"
  ],
  "skills": "./.codex-plugin/skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "cennad": {
      "command": "node",
      "args": [
        "bridge/mcp-server.cjs"
      ],
      "cwd": ".",
      "env": {
        "OGHAM_HOST": "codex"
      }
    }
  }
}

{
  "version": "2.0",
  "language": "ko",
  "adapters": {
    "mode": "auto",
    "enabled": ["ecmascript"]
  },
  "rules": {
    "organ-no-intentmd": {
      "enabled": true,
      "severity": "warning"
    },
    "module-entry-point": {
      "enabled": true,
      "severity": "warning",
      "exempt": [
        "**/shared/agent-artifacts",
        "**/plugins/filid",
        "**/plugins/filid/src",
        "**/plugins/filid/hooks",
        "**/plugins/filid/templates"
      ]
    },
    "max-depth": {
      "enabled": true,
      "severity": "error"
    },
    "circular-dependency": {
      "enabled": true,
      "severity": "error"
    },
    "pure-function-isolation": {
      "enabled": true,
      "severity": "error"
    },
    "zero-peer-file": {
      "enabled": true,
      "severity": "warning"
    }
  },
  "structure": {
    "additionalOrganNames": ["skills", "agents", "references"],
    "additionalAllowedPeers": [
      {
        "basename": "version.ts"
      },
      {
        "basename": "hooks.json"
      },
      {
        "basename": "plugin.json"
      },
      {
        "basename": "mcp_config.json"
      },
      {
        "basename": "SKILL.md"
      },
      {
        "basename": "DESIGN.md"
      },
      {
        "basename": "DETAIL.md"
      },
      {
        "basename": "INTENT.md"
      },
      {
        "basename": "README.md"
      },
      {
        "basename": "README-ko_kr.md"
      },
      {
        "basename": "CLAUDE.md"
      },
      {
        "basename": "package.json"
      },
      {
        "basename": "tsconfig.json"
      },
      {
        "basename": "tsconfig.build.json"
      },
      {
        "basename": "tsconfig.tsbuildinfo"
      },
      {
        "basename": "tsconfig.build.tsbuildinfo"
      },
      {
        "basename": "vitest.config.ts"
      },
      {
        "basename": "vitest.setup.ts"
      },
      {
        "basename": "vitest.e2e.config.ts"
      },
      {
        "basename": "vitest.e2e.setup.ts"
      },
      {
        "basename": "vitest.e2e.globalSetup.ts"
      },
      {
        "basename": "playwright.config.ts"
      },
      {
        "basename": "index.html"
      },
      {
        "basename": "setup.entry.ts",
        "paths": [
          "**/plugins/filid/src/hooks/setup",
          "**/plugins/seiri/src/hooks/setup"
        ]
      },
      {
        "basename": "preToolUse.entry.ts",
        "paths": ["**/plugins/filid/src/hooks/preToolUse"]
      },
      {
        "basename": "agentEnforcer.entry.ts",
        "paths": ["**/plugins/filid/src/hooks/agentEnforcer"]
      },
      {
        "basename": "userPromptSubmit.entry.ts",
        "paths": [
          "**/plugins/filid/src/hooks/userPromptSubmit",
          "**/plugins/seiri/src/hooks/userPromptSubmit"
        ]
      },
      {
        "basename": "postToolUse.entry.ts",
        "paths": ["**/plugins/seiri/src/hooks/postToolUse"]
      },
      {
        "basename": "subagentStart.entry.ts",
        "paths": ["**/plugins/seiri/src/hooks/subagentStart"]
      },
      {
        "basename": "instructionsLoaded.entry.ts",
        "paths": ["**/plugins/seiri/src/hooks/instructionsLoaded"]
      }
    ],
    "entryPointOverrides": {},
    "generatedPaths": [
      "plugins/*/bridge",
      "plugins/*/public",
      "plugins/*/.codex-plugin",
      "plugins/*/hooks",
      "plugins/*/plugin.json",
      "plugins/*/mcp_config.json",
      "plugins/*/hooks.json"
    ]
  }
}

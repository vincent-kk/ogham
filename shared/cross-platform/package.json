    },
    "./paths/plugin-cache": {
      "types": "./dist/paths/state/pluginCache.d.ts",
      "import": "./dist/paths/state/pluginCache.js"
    },
    "./config-scope": {
      "types": "./dist/configScope/index.d.ts",

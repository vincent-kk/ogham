      "types": "./dist/hostPaths/absolute/requireAbsoluteRoot.d.ts",
      "import": "./dist/hostPaths/absolute/requireAbsoluteRoot.js"
    },
    "./host-registry": {
      "types": "./dist/hostRegistry/index.d.ts",
      "import": "./dist/hostRegistry/index.js"
    },
    "./host-registry/runtime": {
      "types": "./dist/hostRegistry/runtime/resolveRuntimeHost.d.ts",
      "import": "./dist/hostRegistry/runtime/resolveRuntimeHost.js"
    },
    "./host-registry/descriptor": {
      "types": "./dist/hostRegistry/operations/resolveHostDescriptor.d.ts",
      "import": "./dist/hostRegistry/operations/resolveHostDescriptor.js"
    },
    "./host-registry/hosts": {
      "types": "./dist/hostRegistry/operations/registry.d.ts",
      "import": "./dist/hostRegistry/operations/registry.js"
    },

  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.11.0",
    "@types/which": "^3.0.4",
    "cross-spawn": "^7.0.6",
    "env-paths": "^3.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "which": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
